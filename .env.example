# Copy to .env and fill in. Used by docker-compose.yml.

# Database / cache
MSSQL_SA_PASSWORD=Strong!Passw0rd
REDIS_PASSWORD=redis_secret

# Auth — MUST be a strong 64+ char secret (the API fails fast on weak/placeholder secrets)
JWT_SECRET=

# AWS / S3-compatible storage (required for uploads + transcoding)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
S3_BUCKET=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=

# Email (SendGrid) — leave blank to disable email (outbox no-ops with a warning)
SENDGRID_API_KEY=

# SMS (Twilio) — leave blank to disable SMS OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# App
APP_BASE_URL=https://yourapp.com

# Transcoding worker concurrency (CPU-bound — keep low)
WORKER_COUNT=2
